# Copy to .env (git-ignored). Never commit real values.
MONGODB_URI=mongodb+srv://<insights_user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=insights-service
INSIGHTS_DB_NAME=insights_db
NATS_URL=nats://localhost:4222
HEALTH_PORT=8001
LOG_LEVEL=INFO
MONGO_TIMEOUT_MS=5000
# Leave empty locally (resolves ../../contracts). Docker sets /app/contracts.
CONTRACTS_DIR=
# Projection set + consumer identity (change BOTH to switch to a rebuilt set, see docs/replay.md)
PROJECTION_SET=
CONSUMER_NAME=activity-insights-v1
QUERY_TIMEOUT_S=2.0
