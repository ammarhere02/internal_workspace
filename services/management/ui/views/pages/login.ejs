<%- include('../partials/auth-head') %>
      <p class="login-box-msg">Sign in to start your session</p>
      <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= ({ google_failed: 'Google sign-in failed. Please try again.', google_disabled: 'Google sign-in is not enabled on this server (AUTH_MODE=dev).', user_inactive: 'Your account has been deactivated in this workspace.', session_expired: 'Your session has expired. Please sign in again.' })[error] || error %></div><% } %>
      <% if (authMode === 'google') { %>
      <form id="login-form" novalidate>
        <div class="input-group mb-3"><input type="email" class="form-control" name="email" placeholder="Email" required maxlength="254" autocomplete="username"><div class="input-group-text"><span class="bi bi-envelope"></span></div></div>
        <div class="input-group mb-3"><input type="password" class="form-control" name="password" placeholder="Password" required minlength="8" maxlength="128" autocomplete="current-password"><div class="input-group-text"><span class="bi bi-lock"></span></div></div>
        <div class="alert alert-danger py-2 small" id="login-error" hidden role="alert"></div>
        <div class="d-grid mb-3"><button type="submit" class="btn btn-primary">Sign In</button></div>
      </form>
      <div class="social-auth-links text-center mb-3">
        <p class="text-secondary small mb-2">— OR —</p>
        <div class="d-grid"><a class="btn btn-outline-primary" href="/auth/google"><i class="bi bi-google me-2"></i>Sign in with Google</a></div>
      </div>
      <% if (signup) { %><p class="mb-0 text-center"><a href="/register">Register a new employee account</a></p><% } %>
      <% } else { %>
      <div class="alert alert-info py-2 mb-2">Development identity mode: no sign-in needed. Use the <em>act as</em> switcher in the header to change user.</div>
      <div class="d-grid"><a class="btn btn-primary" href="/">Continue</a></div>
      <% } %>
<%- include('../partials/auth-foot') %>
