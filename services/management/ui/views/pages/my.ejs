<%- include('../partials/top') %>
<div class="row">
  <div class="col-lg-7">
    <div class="card card-primary card-outline">
      <div class="card-header"><h3 class="card-title">My work items <span class="src-tag src-auth" title="Read from the Management service (NestJS): authoritative">authoritative</span></h3></div>
      <div class="card-body p-0 table-responsive">
        <table class="table table-striped mb-0 align-middle">
          <thead><tr><th>Key</th><th>Title</th><th>Project</th><th>Column</th><th>Priority</th><th>Due</th></tr></thead>
          <tbody id="my-items"><tr><td colspan="6" class="text-secondary p-3">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card card-info card-outline">
      <div class="card-header"><h3 class="card-title">My teams and boards</h3></div>
      <div class="card-body p-0"><ul class="list-group list-group-flush" id="my-projects"><li class="list-group-item text-secondary">Loading…</li></ul></div>
      <div class="card-footer small text-secondary">You can create, edit, assign and move cards on these boards. Teams, projects, members and columns are managed by administrators.</div>
    </div>
  </div>
</div>
<%- include('../partials/bottom', { script: 'my.js' }) %>
