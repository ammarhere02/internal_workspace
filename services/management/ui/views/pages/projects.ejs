<%- include('../partials/top') %>
<div class="card">
  <div class="card-header">
    <h3 class="card-title">Projects <span class="src-tag src-auth" title="Read from the Management service (NestJS): authoritative">authoritative</span></h3>
    <div class="card-tools d-flex align-items-center gap-2">
      <div class="form-check form-switch mb-0 small"><input class="form-check-input" type="checkbox" id="include-archived"><label class="form-check-label" for="include-archived">Show archived</label></div>
      <a class="btn btn-primary btn-sm" href="/projects/new" data-admin-only><i class="bi bi-plus-lg"></i> Add project</a>
      <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" title="Collapse"><i class="bi bi-dash-lg"></i></button>
    </div>
  </div>
  <div class="card-body p-0 table-responsive">
    <table class="table table-striped projects mb-0">
      <thead><tr><th style="width: 1%">#</th><th style="width: 20%">Project Name</th><th style="width: 24%">Team Members</th><th>Project Progress</th><th style="width: 8%" class="text-center">Status</th><th style="width: 22%"></th></tr></thead>
      <tbody id="project-rows"><tr><td colspan="6" class="text-secondary p-3">Loading…</td></tr></tbody>
    </table>
  </div>
  <div class="card-footer d-flex align-items-center">
    <small class="text-secondary">Progress = cards in the board's last column ÷ active cards (authoritative board read). Team members come from the owning team.</small>
    <button class="btn btn-sm btn-outline-secondary ms-auto" id="more-projects" type="button" hidden>Load more</button>
  </div>
</div>
<%- include('../partials/bottom', { script: 'projects.js' }) %>
