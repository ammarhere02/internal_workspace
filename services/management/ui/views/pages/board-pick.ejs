<%- include('../partials/top') %>
<div class="row">
  <div class="col-lg-5">
    <div class="card card-primary card-outline">
      <div class="card-header"><h3 class="card-title"><i class="bi bi-kanban text-primary"></i> Choose a board</h3></div>
      <div class="card-body">
        <label class="form-label" for="pick-project">Project</label>
        <select class="form-select form-select-lg" id="pick-project"><option value="">Loading…</option></select>
        <div class="form-text">One Kanban board per project. Only projects of your teams are listed.</div>
      </div>
      <div class="card-footer"><button class="btn btn-primary" type="button" id="pick-open"><i class="bi bi-kanban"></i> Open board</button></div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card card-outline card-secondary">
      <div class="card-header"><h3 class="card-title">Boards</h3></div>
      <div class="card-body p-0"><ul class="list-group list-group-flush" id="pick-list"><li class="list-group-item text-secondary">Loading…</li></ul></div>
    </div>
  </div>
</div>
<%- include('../partials/bottom', { script: 'board-pick.js' }) %>
