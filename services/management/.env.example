# Copy to .env (git-ignored). Never commit real values.
MONGODB_URI=mongodb+srv://<management_user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=management-service
MANAGEMENT_DB_NAME=management_db
NATS_URL=nats://localhost:4222
PORT=3100
WORKSPACE_SLUG=dev
LOG_LEVEL=info
MONGO_TIMEOUT_MS=5000
NATS_REQUEST_TIMEOUT_MS=2000
OUTBOX_POLL_MS=500
# Leave empty locally (resolves ../../contracts). Docker sets /app/contracts.
CONTRACTS_DIR=
# Outbox relay (phase 4): set false to run the API without publishing (request tests do this)
OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH=50
OUTBOX_MAX_ATTEMPTS=10
# Authentication (phase 6b). dev = seeded identities + x-dev-user header; google = Passport Google OAuth 2.0.
# Create an OAuth client (Web application) in Google Cloud Console with the callback URL below as an authorised redirect URI.
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/auth/google/callback
# at least 16 random characters, e.g. `openssl rand -hex 24`
SESSION_SECRET=
# comma-separated e-mails that get the ADMIN role on sign-in; everyone else is EMPLOYEE
ADMIN_EMAILS=
# E-mail/password sign-in (employees) issues a JWT; secret defaults to SESSION_SECRET. Set LOCAL_SIGNUP_ENABLED=false to stop self-registration.
JWT_SECRET=
LOCAL_SIGNUP_ENABLED=true
# Session timeout: idle window (slides while the user is active) and absolute limit per sign-in
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
